# Copy this file to .env and set your local values.

# Hugging Face auth token (used for model/dataset hub access)
HF_TOKEN=

# Weights & Biases auth token (used when log_wandb=true)
WANDB_API_KEY=

# Optional: override HF cache location
HF_HOME=/workspace/huggingface

# Optional: GPU visibility
# CUDA_VISIBLE_DEVICES=0
